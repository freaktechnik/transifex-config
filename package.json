{
  "name": "transifex-config",
  "version": "5.0.0",
  "description": "Reads the transifex client config and offers utility methods on top of it.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/freaktechnik/transifex-config.git"
  },
  "bugs": "https://github.com/freaktechnik/transifex-config/issues",
  "author": "Martin Giger (https://humanoids.be)",
  "type": "module",
  "main": "./index.js",
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "lint": "eslint index.js lib/ test/ package.json",
    "test": "npm run lint && c8 ava",
    "coverage": "c8 report --reporter lcov",
    "docs": "jsdoc2md index.js lib/*.js > docs/api.md"
  },
  "files": [
    "index.js",
    "docs",
    "lib"
  ],
  "keywords": [
    "transifex",
    "tx"
  ],
  "dependencies": {
    "app-root-path": "^3.1.0",
    "ini": "^7.0.0",
    "lodash.memoize": "^4.1.2"
  },
  "devDependencies": {
    "@freaktechnik/eslint-config-node": "^14.1.0",
    "@freaktechnik/eslint-config-test": "^14.1.0",
    "ava": "^8.3.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "jsdoc-to-markdown": "^9.1.3",
    "random-string": "^0.2.0"
  },
  "ava": {
    "files": [
      "test/*.js",
      "!test/_*.js"
    ]
  }
}
